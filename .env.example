# Agora server environment — copy to .env (or set on your PaaS, e.g. Railway).
#
# Everything here is optional: the server boots with none of it set. Values
# marked "persisted" are folded into <data-dir>/config.json at boot, so they
# also survive if you later unset the variable. Non-secret settings can be
# written straight into config.json instead; keep secrets out of it and pass
# them as env vars.

# ------------------------------------------------------------------ network

# Interface to bind. Loopback by default; 0.0.0.0 to accept LAN/remote
# clients (the Docker image already defaults to 0.0.0.0). Persisted.
#AGORA_BIND=0.0.0.0

# Listen port. AGORA_PORT wins over PORT (which PaaS platforms like Railway
# inject themselves). Persisted. Default: 4470.
#AGORA_PORT=4470

# Show admin-key login controls in web/desktop and mobile clients. This is a
# UI-only switch: the admin key remains valid for API authentication. Like the
# other overrides, the value is persisted to config.json.
#AGORA_ADMIN_LOGIN_ENABLED=true  # also accepts 1/0, yes/no, and on/off

# --------------------------------------------------------- google sign-in
# Optional "Sign in with Google" for the web UI, desktop app, and mobile app,
# as an alternative to pasting the admin key. Create an OAuth client of
# type "Web application" at https://console.cloud.google.com/apis/credentials
# and register the redirect URI:  <AGORA_PUBLIC_URL>/api/auth/google/callback
# All four are persisted into config.json.

# The OAuth client credentials.
#AGORA_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
#AGORA_GOOGLE_CLIENT_SECRET=GOCSPX-...

# Fallback admission list for fresh accounts (comma-separated). Matching users
# are created as members; existing users and invited emails can also sign in.
# Leaving it empty makes Google sign-in invite-only, not disabled. Google and
# Apple allowlists feed the same admission check, so a wildcard in either list
# also admits sign-ins from the other provider. `*@example.com` admits a whole
# domain; a value of `*` lets anyone who completes Google OAuth create a member
# account, so use it only for a public server.
#AGORA_GOOGLE_ALLOWED_EMAILS=you@gmail.com,partner@gmail.com

# Public https origin of this deployment — must match the host in the
# redirect URI registered with Google. Without it the callback URL is derived
# per request from Host/X-Forwarded-Proto headers.
#AGORA_PUBLIC_URL=https://agora.up.railway.app

# ------------------------------------------------------------------- voice

# Enables server-side voice. OpenAI covers STT + TTS; Groq covers STT
# (Whisper) and TTS (Orpheus). Voice UI stays hidden on all clients when
# neither half is enabled. Read from the environment on every use — not
# persisted to config.json.
#OPENAI_API_KEY=sk-...
#GROQ_API_KEY=gsk-...

# ------------------------------------------------------------------ agents

# How many consecutive agent-authored messages the hub relays between agents
# in one channel/thread before going quiet until a human speaks again (any
# human message resets the streak). Raise it for longer unattended
# agent-to-agent chains, lower it to keep bots on a shorter leash; each agent
# frame's `bot_turns_left` reports the remaining budget. Values below 1 and
# unparseable ones fall back to the default. Read once at startup — NOT
# persisted to config.json, so unsetting it reverts to the default. Default: 10.
#AGORA_BOT_LOOP_LIMIT=10

# Safety ceiling for a bot_loop_limit requested by an individual agent during
# registration. Values below 1 or unparseable ones fall back to 50. Read once
# at startup and not persisted to config.json.
#AGORA_BOT_LOOP_MAX=50

# --------------------------------------------------------------- migration

# Seed a BRAND-NEW data dir (no agora.db yet) by downloading an export
# archive on first boot; ignored once data exists. Handy for standing up a
# fresh deployment from a backup.
#AGORA_IMPORT_URL=https://example.com/agora-export.tar.gz

# ----------------------------------------------------------------- logging

# Standard tracing filter (error|warn|info|debug|trace, per-module syntax).
#RUST_LOG=info
