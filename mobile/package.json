{
  "name": "agora-mobile",
  "version": "0.1.0",
  "main": "index.js",
  "dependencies": {
    "@agora/core": "file:../packages/core",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/slider": "^5.2.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.9",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.1",
    "expo-audio": "~57.0.0",
    "expo-background-task": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.3",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.2",
    "expo-keep-awake": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-paste-input": "0.2.2",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.3",
    "expo-speech": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-store-review": "~57.0.2",
    "expo-task-manager": "~57.0.2",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.0",
    "lucide-react-native": "^1.24.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "^0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@react-native/jest-preset": "^0.86.0",
    "@storybook/addon-ondevice-actions": "^10.5.4",
    "@storybook/addon-ondevice-controls": "^10.5.4",
    "@storybook/react-native": "^10.5.4",
    "@types/jest": "~29.5.14",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "~29.7.0",
    "jest-expo": "^57.0.1",
    "storybook": "^10.5.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "storybook": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --dev-client",
    "storybook:ios": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --dev-client --ios",
    "storybook:android": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --dev-client --android",
    "storybook-generate": "sb-rn-get-stories",
    "test": "jest",
    "test:integration": "AGORA_INTEGRATION=1 jest -c jest.integration.config.js --forceExit",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "tests/integration.test.ts"
    ],
    "moduleNameMapper": {
      "^react-native-webview$": "<rootDir>/tests/mocks/webview.js",
      "^expo-video$": "<rootDir>/tests/mocks/expo-video.js",
      "^@agora/core$": "<rootDir>/../packages/core/src/index.ts",
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@shopify/flash-list)"
    ]
  }
}
