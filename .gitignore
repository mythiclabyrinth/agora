# Rust build artifacts
/target/
/.worktrees/
.worktree-env
.cargo-target/

# Tauri codegen (regenerated on every build)
crates/agora-desktop/gen/schemas/

# Runtime state (headless server default data dir)
/data/

# Node (Tauri CLI is invoked via npx; nothing should land here)
node_modules/

# Expo mobile app: native project is generated by `expo prebuild`/`expo run`
mobile/ios/
mobile/android/
mobile/.expo/

# Local environment (secrets); .env.example is the committed template
.env
.env.*
!.env.example
.venv/

# Bridge runtime state (per-machine channel->session bindings) and logs
bridges/claude-cli/state.json
bridges/codex-cli/state.json
bridges/cursor-cli/state.json
bridges/*/bridge.log
__pycache__/

# Web app build output (regenerated by the web build)
web/dist/
web/storybook-static/

# OS noise
.DS_Store

# Claude Code local session/agent state
.claude/
.codex/
