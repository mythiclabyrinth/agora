# Cursor CLI bridge configuration. Copy to .env and fill in the connection.

# Required: Agora base URL and a token minted on Connections → Pair an agent.
AGORA_URL=https://your-agora-host
AGORA_PAIRING_TOKEN=your-pairing-token
# AGORA_PAIRING_TOKEN_FILE=/home/you/.config/agora/cursor-token

# Agent identity.
# AGENT_ID=cursor-cli
# AGENT_NAME=Cursor
AGENT_AVATAR=assets/cursor.png

# Cursor CLI. Empty CURSOR_MODEL uses Cursor Auto; `/models` lists live choices.
# CURSOR_BIN=agent
# CURSOR_MODEL=
# CURSOR_ARGS=

# Default: editable agent. Channels can lower this with /mode plan or /mode ask.
# CURSOR_MODE=agent
# CURSOR_ALLOW_FORCE=0

# Cursor's workspace sandbox is enabled by default. This global escape hatch is
# intentionally not controllable from chat.
# CURSOR_DISABLE_SANDBOX=0

# Colon-separated directories that /new and /worktree may use. /new is disabled
# when this is empty.
# CURSOR_ALLOWED_ROOTS=/home/you/code:/home/you/work
# CURSOR_AUTO_WORKTREE=0

# CURSOR_TLDR=0
# CURSOR_TLDR_MIN_CHARS=1500
# CURSOR_TIMEOUT=1800
# SESSIONS_LIMIT=10
# STATE_FILE=/home/you/.config/agora/cursor-bridge-state.json
# CONTEXT_BUFFER=50
# Optional per-agent relay cap; unset inherits the server default.
# AGORA_BOT_LOOP_LIMIT=10
# AGORA_PEER_AGENTS=claude-cli,codex-cli
