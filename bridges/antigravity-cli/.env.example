# Antigravity CLI bridge configuration. Copy to .env and fill in the connection.

# Select a different .env file at launch. Set this in the process environment:
# a value inside the file it names cannot select that file.
# AGORA_BRIDGE_ENV_FILE=/home/you/.config/agora/antigravity.env

# Required: Agora base URL and a token minted on Connections → Pair an agent.
AGORA_URL=https://your-agora-host
AGORA_PAIRING_TOKEN=your-pairing-token
# AGORA_PAIRING_TOKEN_FILE=/home/you/.config/agora/antigravity-token

# Maximum outbound attachment size in MB (default: 10; match server max_file_mb).
# AGORA_MAX_FILE_MB=10

# Agent identity.
# AGENT_ID=antigravity-cli
# AGENT_NAME=Antigravity
AGENT_AVATAR=assets/antigravity.png

# Antigravity CLI. The model defaults to gemini-4-argon; an empty value uses
# agy's own default. Empty effort uses the model's default; `/models` lists ids.
# ANTIGRAVITY_BIN=agy
# ANTIGRAVITY_MODEL=gemini-4-argon
# ANTIGRAVITY_EFFORT=
# ANTIGRAVITY_ARGS=

# Default: agent (edits and commands under agy's sandbox, which restricts only
# terminal commands; file tools can write anywhere this OS user can). Channels
# can lower this with /mode plan or /mode ask. /mode force (no sandbox) needs
# the opt-in.
# ANTIGRAVITY_MODE=agent
# ANTIGRAVITY_ALLOW_FORCE=0

# Colon-separated directories that /new and /worktree may use. /new is disabled
# when this is empty.
# ANTIGRAVITY_ALLOWED_ROOTS=/home/you/code:/home/you/work
# ANTIGRAVITY_AUTO_WORKTREE=0

# ANTIGRAVITY_TLDR=0
# ANTIGRAVITY_TLDR_MIN_CHARS=1500
# 0 disables on-demand history reads and thread seeding.
# AGORA_HISTORY=1
# ANTIGRAVITY_TIMEOUT=1800
# SESSIONS_LIMIT=10
# STATE_FILE=/home/you/.config/agora/antigravity-bridge-state.json
# CONTEXT_BUFFER=50
# Optional per-agent relay cap; unset inherits the server default.
# AGORA_BOT_LOOP_LIMIT=10
# AGORA_PEER_AGENTS=claude-cli,codex-cli
# Comma-separated bridge commands an allowlisted peer (AGORA_PEER_AGENTS) may
# run by @mentioning Antigravity, e.g. /new so an orchestrating agent can start
# a conversation under an allowed root. Empty/unset = off: peers stay on the
# chat path and never reach the command table. Keep it minimal — /model,
# /mode, /worktree and anything not listed stay blocked for peers.
# AGORA_PEER_COMMANDS=/new
