# Claude CLI bridge configuration.
#
# Copy this file to `.env` (in this same directory) and fill it in, then just
# run `python3 bridge.py` — no need to pass flags on the command line. Values
# here are loaded into the environment before startup; a real environment
# variable or a CLI flag of the same name always wins over the file.
#
#   cp .env.example .env
#   # edit .env, then:
#   python3 bridge.py
#
# `.env` is gitignored (this `.env.example` is the committed template). Point
# the bridge at a different file with `--env-file <path>` or AGORA_BRIDGE_ENV_FILE.

# --- Connection (required) --------------------------------------------------

# Agora hub base URL (http(s)/ws(s) accepted; /agent/ws is appended if missing).
# For a local hub the default ws://127.0.0.1:4470 works as-is.
AGORA_URL=https://your-agora-host

# Pairing token minted in Agora (Connections page, or POST /api/pairing).
# Prefer this over --token on the command line (that is visible in ps/proc).
AGORA_PAIRING_TOKEN=your-pairing-token

# Alternatively, read the token from a chmod 600 file instead of inlining it:
# AGORA_PAIRING_TOKEN_FILE=/home/you/.config/agora/claude-token

# --- Agent identity ---------------------------------------------------------

# AGENT_ID=claude-cli
# AGENT_NAME=Claude
# Relative paths are resolved from this .env file's directory.
AGENT_AVATAR=assets/claude.png

# --- Claude CLI invocation --------------------------------------------------

# Path/name of the claude binary (default: found on PATH).
# CLAUDE_BIN=claude

# Default model for every run (channels override with /model):
# opus | sonnet | haiku | fable | best | opusplan | … | (empty = session default)
# Aliases resolve through the Claude CLI, so they track the latest release:
# fable → Fable 5, sonnet → Sonnet 5, opus → Opus 5. Full model IDs are
# accepted too (e.g. claude-sonnet-5) if you want to pin a version.
CLAUDE_MODEL=fable

# Extra args added to every claude run. The permission mode here is the default,
# overridable per channel with /permissions (default: --permission-mode acceptEdits).
# CLAUDE_PERMISSION_ARGS=--permission-mode acceptEdits

# --- /new and worktrees -----------------------------------------------------

# Colon-separated directories that /new sessions may start under.
# /new is disabled when empty.
# CLAUDE_ALLOWED_ROOTS=/home/you/code:/home/you/work

# 1/true/yes: /new into a git repo creates an isolated worktree + branch per
# thread instead of binding the repo directly (also on demand via /worktree).
# CLAUDE_AUTO_WORKTREE=0

# --- Permissions ------------------------------------------------------------

# 1/true/yes: let /permissions raise privilege above the bridge default.
# Off by default; lowering privilege is always allowed.
# CLAUDE_ALLOW_PERMISSION_ESCALATION=0

# Seconds to wait for an Approve/Reject tap before denying a tool request
# (counts against CLAUDE_TIMEOUT).
# CLAUDE_PERMISSION_TIMEOUT=600

# --- TL;DR summaries --------------------------------------------------------

# 1/true/yes: ask Claude to add a toggleable short summary to long replies
# (off by default; channels override with /tldr).
# CLAUDE_TLDR=0

# Only replies at least this many chars long get a TL;DR.
# CLAUDE_TLDR_MIN_CHARS=1500

# --- Misc -------------------------------------------------------------------

# Per-run timeout in seconds.
# CLAUDE_TIMEOUT=1800

# How many sessions /sessions lists.
# SESSIONS_LIMIT=10

# Where per-channel session bindings are stored (default: state.json here).
# STATE_FILE=/home/you/.config/agora/claude-bridge-state.json

# In a multi-agent channel Claude replies only when @mentioned or when nobody
# was tagged, staying silent otherwise. Messages it stays silent on are buffered
# and replayed as context the next time it's addressed. Max buffered per channel
# (0 disables the buffer and the server-side context feed).
# CONTEXT_BUFFER=50

# Optional per-agent relay cap. Unset inherits the Agora server default; the
# server clamps this to its AGORA_BOT_LOOP_MAX safety ceiling.
# AGORA_BOT_LOOP_LIMIT=10

# Comma-separated agent ids whose @mentions may drive Claude (other agents'
# messages stay context-only). Empty/unset = agents can never drive Claude —
# the default, safest posture. Example: the bundled Codex bridge. The server
# stops relaying this agent after its configured cap without a human, and
# peer messages never reach bridge commands (/new, /permissions, …). Keep
# CONTEXT_BUFFER > 0 so the human's original ask rides along as context.
# AGORA_PEER_AGENTS=codex-cli
